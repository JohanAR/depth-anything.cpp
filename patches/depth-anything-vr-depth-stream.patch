+                ok = c->engine->depth_relative(img, depth, H, W);
+            else if (c->engine->is_mono())
+                ok = c->engine->depth_mono(img, depth, aux, H, W);
+            else
+                ok = c->engine->depth_native_image(img, depth, aux, H, W);
